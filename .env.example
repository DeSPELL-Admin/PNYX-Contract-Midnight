# ---- network (pass --network <standalone|preview|preprod> to every script) ----
# Optional URL overrides
# MIDNIGHT_INDEXER_URL=
# MIDNIGHT_INDEXER_WS_URL=
# MIDNIGHT_NODE_URL=
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# ---- wallet (≈ PRIVATE_KEY / OWNER_KEY) ----
MIDNIGHT_WALLET_SEED=            # 64 hex chars; fund its unshielded address with tNight from the preprod faucet

# ---- TournamentFinalizer deploy (≈ FINALIZE_SIGNER / FINALIZE_TYPEHASH) ----
FINALIZE_SIGNER=                 # operator coin public key (64 hex) — must equal PNYX-BE's Midnight wallet coin pk
FINALIZE_DOMAIN_TAG=pnyx:finalize:v1

# ---- VotePointManager deploy ----
VOTE_SIGNER=
VOTE_DOMAIN_TAG=pnyx:vote:v1

# ---- user-side private inputs for finalizeTournament / settle (never leave the client in production) ----
USER_SECRET=
VOTE_SALT=

# ---- operator-side inputs for grant scripts ----
USER_PK=                         # pureCircuits.userPublicKey(USER_SECRET)
NEW_SIGNER=
